{
  "schemaVersion": 1,
  "id": "open-mercato.telegram",
  "name": "Telegram",
  "version": "0.1.0",
  "apiVersion": "0.1",
  "main": "dist/index.js",
  "capabilities": ["chatProviders"],
  "permissions": [],
  "contributes": { "chatProviders": [{
    "id": "telegram", "label": "Telegram",
    "credentials": [{ "name": "token", "label": "Bot token" }],
    "limits": { "maxText": 4096, "buttonsPerMessage": 100, "perChatPerSecond": 1, "perBotPerSecond": 30 },
    "commandPrefix": "/", "groupPrefix": "-",
    "discoveryUrl": "https://t.me"
  }] }
}
